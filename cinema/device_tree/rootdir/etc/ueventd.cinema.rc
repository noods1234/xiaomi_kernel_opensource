# ueventd.cinema.rc
# Node ownership and permissions for the cinema subsystem:
#   /sys/kernel/cinema_mode/  — CPU/latency performance coordinator
#   /sys/kernel/cinema_end/   — eND optical cartridge sysfs interface
#   /dev/cinema_end           — MCU bridge daemon presence miscdev
#
# Drop into device/xiaomi/aurora/ and add to BoardConfig.mk:
#   TARGET_UEVENTD_RC_FILES += device/xiaomi/aurora/ueventd.cinema.rc
#
# ueventd processes UEVENT_ADD notifications from the kernel and applies
# these rules every time a sysfs node appears — including after
# cinema_mode.ko / cinema_end.ko are unloaded and reloaded (testing,
# firmware updates).  An init.rc "on boot" chown fires only once per boot
# and is lost after rmmod/insmod; ueventd is the correct mechanism.
#
# Format: <path>  <permissions>  <owner>  <group>

# cinema_mode: the kernel attribute is defined 0600 (owner-rw).
# init writes this node on persist.cinema.mode property change; init runs
# as root (uid 0) and requires no permission relaxation.  Match kernel.
/sys/kernel/cinema_mode/enable      0600  root    root

# /dev/cinema_end miscdev — exclusive open by the MCU bridge daemon.
# 0600 root:root: only the daemon (which runs as root or with CAP_SYS_ADMIN)
# may open it.  The fd lifecycle signals MCU presence to the kernel;
# closing it (including on crash) triggers the kernel offline transition.
/dev/cinema_end                     0600  root    root

# cinema_end sysfs — app-rw nodes (enable, nd_setpoint, mode).
# Written by system_server / cameraserver on behalf of the camera app.
/sys/kernel/cinema_end/enable       0660  system  system
/sys/kernel/cinema_end/nd_setpoint  0660  system  system
/sys/kernel/cinema_end/mode         0660  system  system

# cinema_end sysfs — daemon-rw nodes (nd_actual, cell_temp, fault_clear).
# Written exclusively by the MCU bridge daemon; camera app reads only.
# 0640: system owns write; camera group can read.
/sys/kernel/cinema_end/nd_actual    0640  system  camera
/sys/kernel/cinema_end/cell_temp    0640  system  camera
/sys/kernel/cinema_end/fault_clear  0200  system  system

# cinema_end sysfs — read-only status for all cinema actors.
/sys/kernel/cinema_end/status       0444  system  system
