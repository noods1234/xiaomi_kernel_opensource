# genfs_contexts — cinema_mode and cinema_end sysfs labels
# Merged into the vendor sepolicy at build time.

# cinema_mode
genfscon sysfs /kernel/cinema_mode          u:object_r:cinema_mode_sysfs_dir:s0
genfscon sysfs /kernel/cinema_mode/enable   u:object_r:cinema_mode_sysfs:s0

# cinema_end directory
genfscon sysfs /kernel/cinema_end           u:object_r:cinema_end_sysfs_dir:s0

# cinema_end app-rw: camera app / system_server write path
genfscon sysfs /kernel/cinema_end/enable        u:object_r:cinema_end_sysfs_app_rw:s0
genfscon sysfs /kernel/cinema_end/nd_setpoint   u:object_r:cinema_end_sysfs_app_rw:s0
genfscon sysfs /kernel/cinema_end/mode          u:object_r:cinema_end_sysfs_app_rw:s0

# cinema_end daemon-rw: MCU bridge daemon write path only
genfscon sysfs /kernel/cinema_end/nd_actual     u:object_r:cinema_end_sysfs_daemon_rw:s0
genfscon sysfs /kernel/cinema_end/cell_temp     u:object_r:cinema_end_sysfs_daemon_rw:s0
genfscon sysfs /kernel/cinema_end/fault_clear   u:object_r:cinema_end_sysfs_daemon_rw:s0

# cinema_end ro: read-only status for all actors
genfscon sysfs /kernel/cinema_end/status        u:object_r:cinema_end_sysfs_ro:s0
