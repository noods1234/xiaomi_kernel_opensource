# file_contexts — cinema mode vendor file labels
# Merged into the vendor sepolicy at build time.
#
# Without these entries the cinema shell scripts carry the default
# vendor_file label.  The cinema_io_tune domain's exec-type transition
# requires the scripts to be labeled cinema_io_tune_exec, otherwise
# the SELinux domain transition does not fire and the services either
# fail to start or run in the wrong domain.

/vendor/bin/cinema_io_tune\.sh      u:object_r:cinema_io_tune_exec:s0
/vendor/bin/cinema_on_apply\.sh     u:object_r:cinema_io_tune_exec:s0
/vendor/bin/cinema_off_apply\.sh    u:object_r:cinema_io_tune_exec:s0
