# cinema_mode.te
# SELinux policy for:
#   /sys/kernel/cinema_mode/   (performance coordinator)
#   /sys/kernel/cinema_end/    (eND optical cartridge sysfs interface)
#   /dev/cinema_end            (MCU bridge daemon presence miscdev)
# and for init.cinema.rc property triggers.

# ---- Type declarations ----

# cinema_mode sysfs
type cinema_mode_sysfs, fs_type, sysfs_type;
type cinema_mode_sysfs_dir, fs_type, sysfs_type;

# cinema_end sysfs — three types for precise grant scoping:
#
#   cinema_end_sysfs_app_rw:
#     enable, nd_setpoint, mode — written by system_server / cameraserver
#     on behalf of the camera app; read by the daemon.
#
#   cinema_end_sysfs_daemon_rw:
#     nd_actual, cell_temp, fault_clear — written exclusively by the MCU
#     bridge daemon.  cameraserver/system_server have NO write access here.
#     This prevents a compromised cameraserver from forging MCU telemetry
#     or clearing thermal safety faults.
#
#   cinema_end_sysfs_ro:
#     status — read by all cinema actors; written by no one from userspace.
#
type cinema_end_sysfs_dir, fs_type, sysfs_type;
type cinema_end_sysfs_app_rw, fs_type, sysfs_type;
type cinema_end_sysfs_daemon_rw, fs_type, sysfs_type;
type cinema_end_sysfs_ro, fs_type, sysfs_type;

# /dev/cinema_end miscdev — daemon holds this fd to signal MCU presence.
# Closing it (including on crash) triggers the kernel offline transition.
type cinema_end_device, dev_type;

# Dedicated exec types
type cinema_io_tune_exec, exec_type, vendor_file_type, file_type;
type cinema_end_daemon_exec, exec_type, vendor_file_type, file_type;

# Domains
type cinema_io_tune, domain;
type cinema_end_daemon, domain;

# ---- cinema_end_daemon ----
#
# The MCU bridge daemon:
#   - Opens /dev/cinema_end (exclusive; kernel owns MCU presence state)
#   - Reads nd_setpoint and mode (polls for changes from camera app)
#   - Writes nd_actual, cell_temp, fault_clear (daemon-rw nodes only)
#   - Does NOT write enable, nd_setpoint, mode (those are app-rw)
#
# CAP_SYS_ADMIN: required by the kernel driver for sysfs writes.
# Scoped to cinema_end_daemon only — system_server does NOT get sys_admin
# from this policy.

allow cinema_end_daemon cinema_end_device:chr_file { open read write ioctl getattr };

allow cinema_end_daemon cinema_end_sysfs_dir:dir         { open read search getattr };
allow cinema_end_daemon cinema_end_sysfs_app_rw:file     { read open getattr };
allow cinema_end_daemon cinema_end_sysfs_daemon_rw:file  { read write open getattr };
allow cinema_end_daemon cinema_end_sysfs_ro:file         { read open getattr };

allow cinema_end_daemon self:capability sys_admin;

# ---- cameraserver: app-rw write + all reads ----
#
# The camera HAL writes enable, nd_setpoint, and mode.  It reads
# status, nd_actual, cell_temp for UI.  It has NO access to daemon-rw
# nodes so a compromised cameraserver cannot forge telemetry or clear faults.

allow cameraserver cinema_end_sysfs_dir:dir         { open read search getattr };
allow cameraserver cinema_end_sysfs_app_rw:file     { read write open getattr };
allow cameraserver cinema_end_sysfs_daemon_rw:file  { read open getattr };
allow cameraserver cinema_end_sysfs_ro:file         { read open getattr };

# ---- system_server: same scope as cameraserver ----
#
# system_server proxies Camera2 API calls and sets the cinema mode property.
# It writes enable and nd_setpoint via the HAL.  It does NOT get CAP_SYS_ADMIN
# from this policy — that would be an unacceptable system-wide privilege
# escalation.  The HAL calls already run in a context (cameraserver) with
# the capability grant above.

allow system_server cinema_end_sysfs_dir:dir         { open read search getattr };
allow system_server cinema_end_sysfs_app_rw:file     { read write open getattr };
allow system_server cinema_end_sysfs_daemon_rw:file  { read open getattr };
allow system_server cinema_end_sysfs_ro:file         { read open getattr };

# ---- init: write enable from init.cinema.rc property trigger ----
allow init cinema_end_sysfs_dir:dir         { open read search getattr };
allow init cinema_end_sysfs_app_rw:file     { read write open getattr };
allow init cinema_end_sysfs_daemon_rw:file  { read open getattr };
allow init cinema_end_sysfs_ro:file         { read open getattr };

# ---- neverallow guards ----

# Only the daemon may write daemon-rw nodes (telemetry, fault_clear).
neverallow { domain -cinema_end_daemon } cinema_end_sysfs_daemon_rw:file write;

# Only declared domains may write app-rw nodes (enable, nd_setpoint, mode).
neverallow { domain
	-init
	-system_server
	-cameraserver
} cinema_end_sysfs_app_rw:file write;

# Only the daemon may open the miscdev.
neverallow { domain -cinema_end_daemon } cinema_end_device:chr_file write;

# ---- cinema_io_tune service ----
# (No changes from previous policy)

allow cinema_io_tune shell_exec:file { read execute open getattr };
allow cinema_io_tune cinema_io_tune_exec:file { read execute open getattr };
allow cinema_io_tune cinema_io_tune:process { fork sigchld };
allow cinema_io_tune vendor_file_type:dir { open read search getattr };
allow cinema_io_tune vendor_file_type:file { read open getattr };
allow cinema_io_tune sysfs_block:dir { open read search getattr };
allow cinema_io_tune sysfs_block:file { read write open getattr };
allow cinema_io_tune cinema_mode_sysfs_dir:dir { open read search getattr };
allow cinema_io_tune cinema_mode_sysfs:file { read write open getattr };
allow cinema_io_tune sysctl_vm:dir { open read search getattr };
allow cinema_io_tune sysctl_vm:file { read write open getattr };
allow cinema_io_tune sysctl_fs:dir { open read search getattr };
allow cinema_io_tune sysctl_fs:file { read write open getattr };
allow cinema_io_tune proc_swaps:file { read open getattr };
allow cinema_io_tune self:capability sys_admin;
allow cinema_io_tune self:capability dac_override;
allow cinema_io_tune system_file:file { read open getattr execute execute_no_trans };
allow cinema_io_tune swap_block_device:blk_file { open read write ioctl getattr };
allow cinema_io_tune kmsg_device:chr_file { open write getattr };

# ---- init: cinema_mode sysfs and scripts ----
allow init cinema_mode_sysfs_dir:dir { open read search getattr };
allow init cinema_mode_sysfs:file { read write getattr open };
allow init cinema_io_tune_exec:file { read execute execute_no_trans open getattr };

# ---- Property access ----
allow system_server cinema_prop:property_service set;
allow cameraserver cinema_prop:property_service set;

type cinema_prop, property_type;
type sys_cinema_prop, property_type;

neverallow { domain -init -system_server -cameraserver } cinema_prop:property_service set;
neverallow { domain -init } sys_cinema_prop:property_service set;
