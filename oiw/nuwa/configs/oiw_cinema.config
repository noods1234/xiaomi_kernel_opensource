# OIW-ROM cinema kernel tuning fragment (GKI defconfig delta).
#
# VERIFIED on 2026-07-06 against the exact source this repo's CI builds —
# crdroidandroid/android_kernel_xiaomi_sm8550 @ 15.0 — by generating the real kernel config
# (`make ARCH=arm64 O=out gki_defconfig` with these lines appended) and confirming every symbol
# below survives into the produced `.config`. This is a verified delta, not an aspirational list.
#
# ------------------------------------------------------------------------------------------------
# HONEST SCOPE NOTE — read before assuming this does more than it does:
# This is a GKI (Generic Kernel Image) build. The camera/ISP/sensor drivers are NOT in this Image;
# they are proprietary VENDOR kernel modules loaded from the stock (untouched) vendor partition.
# A GKI kernel therefore CANNOT change camera / RAW / log / ISP / manual-control behavior — that
# lives above this layer (see docs/ARCHITECTURE.md §3 and docs/CAMERA_PIPELINE.md). The genuinely
# useful, GKI-legal, currently-MISSING cinema delta is broader external-footage-drive filesystem
# support. That is what this fragment adds, and nothing more is claimed.
#
# Verified ALREADY-ENABLED in gki_defconfig (intentionally NOT re-added here, they would be no-op
# churn): USB_UAS, USB_STORAGE, USB_CONFIGFS_MASS_STORAGE, SCSI, SCSI_UFSHCD, EXFAT_FS, VFAT_FS,
# F2FS_FS, EXT4_FS, DMABUF_HEAPS, DMABUF_SYSFS_STATS, THERMAL, THERMAL_NETLINK, THERMAL_STATISTICS,
# CGROUP_FREEZER, TYPEC, TYPEC_TCPM, V4L_PLATFORM_DRIVERS.
# ------------------------------------------------------------------------------------------------

# --- NTFS read/write for footage drives formatted by Windows/macOS editors (in-tree fs/ntfs3) ---
# Verified absent from stock gki_defconfig; verified it compiles in and survives into .config.
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y

# --- UDF (some card readers / UDF-formatted media); low-cost breadth, verified survives ---
CONFIG_UDF_FS=y

# --- Cosmetic but useful: identify the flashed cinema kernel in build metadata (uname/localversion).
# Verified to override the workflow's default CONFIG_LOCALVERSION (kconfig last-assignment-wins) when
# this fragment is appended after the "Add Custom Kernel Name" step.
CONFIG_LOCALVERSION="-oiw-cinema"
