# OIW-ROM kernel config fragment for the nuwa GKI build (gki_defconfig base).
# Apply with: scripts/kconfig/merge_config.sh arch/arm64/configs/gki_defconfig <this file>
# Every option below is a standard upstream/GKI Kconfig symbol — none are vendor-private. Verify each still
# exists in the actual kernel source tree before building; GKI symbol availability shifts between kernel versions.
# UNVERIFIED against the real crdroidandroid/android_kernel_xiaomi_sm8550 tree — see kernel/oiw/nuwa/README.md.

# --- Media / V4L2 (camera-adjacent, generic subsystem, not the proprietary sensor driver) ---
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y

# --- DMA-BUF / ION (buffer sharing between camera HAL, encoder, and GPU) ---
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_SYSFS_STATS=y

# --- USB mass storage / external SSD support (docs/STORAGE_MEDIA.md) ---
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y

# --- Filesystems for external SSD (docs/STORAGE_MEDIA.md §3) ---
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_F2FS_FS=y
CONFIG_EXT4_FS=y

# --- Thermal (read-side only; governor policy stays app-level per docs/THERMAL_POWER.md §2) ---
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_NETLINK=y
CONFIG_THERMAL_STATISTICS=y
CONFIG_THERMAL_GOV_STEP_WISE=y

# --- cgroup freezer (used by "foreground-only enforcement" background-service behavior, docs/THERMAL_POWER.md) ---
CONFIG_CGROUP_FREEZER=y

# --- USB PD / Type-C (charging-while-recording awareness, docs/THERMAL_POWER.md §4-5) ---
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
